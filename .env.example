# Server only. Never prefix any of these with NEXT_PUBLIC_.

# Supabase (Project Settings, API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The secret / service_role key. Keeps writes server side. Never put it in the browser or in git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail (see README: turn on 2 Step Verification, then create an App Password)
GMAIL_USER=yourwaitlistaddress@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
# Optional. The name people see as the sender.
MAIL_FROM_NAME=Teach for a Cause

# Two long random strings. Generate each with: openssl rand -hex 32
OTP_SECRET=change-me
RATE_LIMIT_SALT=change-me

# Set to true to show a real count of waiting families on the parent success screen.
WAITLIST_SHOW_COUNTS=false

# Optional: Set a secret passkey to protect the /admin dashboard route
# ADMIN_SECRET_KEY=your-custom-admin-password

# Your deployed URL, used for Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
