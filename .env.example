# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Any long random string. Used to hash IP addresses before the rate limit check.
RATE_LIMIT_SALT=change-me
# Set to true to show a real count of waiting families on the success screen.
WAITLIST_SHOW_COUNTS=false
# Your deployed URL, used for Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
